# ============================================================
# PrimeAutoTech — environment template (copy to .env.local)
# Paste your 3 values from https://dashboard.emailjs.com then
# restart `npm run dev`. Setup steps are in README.md.
# ============================================================

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional: a separate template just for consultation bookings.
# Leave empty to reuse the template above.
NEXT_PUBLIC_EMAILJS_CONSULTATION_TEMPLATE_ID=

# Optional: your production domain (used for SEO / sitemap)
NEXT_PUBLIC_SITE_URL=
